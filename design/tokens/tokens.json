{
  "$name": "Waterline",
  "$version": "1.0.0",
  "$description": "Korean institutional palette — obangsaek / dancheong accents over hanji ivory, with the navy-and-cobalt chrome of Korean public and financial services.",
  "color": {
    "ground":         { "value": "#F5F3EE", "comment": "hanji ivory — page background" },
    "surface":        { "value": "#FFFFFF", "comment": "cards, header, inputs" },
    "surfaceSunken":  { "value": "#EFEBE2", "comment": "table heads, not-disclosed wells" },
    "surfaceMuted":   { "value": "#FBFAF7", "comment": "building interior, disabled fields" },

    "line":           { "value": "#E2DCD0", "comment": "default hairline" },
    "lineStrong":     { "value": "#C3BCAE", "comment": "input and secondary-button borders" },
    "lineSoft":       { "value": "#DCD6C9", "comment": "floor lines inside the building" },
    "lineQuiet":      { "value": "#DDD6C8", "comment": "section rules" },
    "bracket":        { "value": "#B9B2A6", "comment": "appraisal bracket on the diagram" },

    "ink":            { "value": "#14243A", "contrastOnGround": 14.2, "comment": "primary text" },
    "inkBody":        { "value": "#33455C", "contrastOnGround": 9.1,  "comment": "body copy" },
    "inkMuted":       { "value": "#5A6B7E", "contrastOnGround": 5.6,  "comment": "secondary / helper" },
    "inkLabel":       { "value": "#6B7A8C", "contrastOnGround": 4.6,  "comment": "uppercase labels, mono keys" },
    "inkDim":         { "value": "#7D8B9B", "contrastOnGround": 3.6,  "comment": "LARGE TEXT ONLY: >=18.66px bold or >=24px" },
    "inkDisabled":    { "value": "#8C8B82", "comment": "idle pipeline step titles" },
    "inkIdle":        { "value": "#A9A294", "comment": "idle dots, em-dash placeholders" },

    "navy":           { "value": "#0F2A4A", "comment": "authority — wordmark, primary button" },
    "cobalt":         { "value": "#1B5FAA", "comment": "cheong 청 — links, focus, progress" },

    "safe":           { "value": "#1F7A5C", "comment": "cheong 청 blue-green — SAFE. Verdicts only." },
    "caution":        { "value": "#A8701A", "comment": "hwang 황 ochre — CAUTION. Verdicts only." },
    "cautionInk":     { "value": "#8A5A11", "comment": "ochre text on a tinted banner" },
    "danger":         { "value": "#C0352B", "comment": "jeok 적 vermilion — DANGER and the load line. Verdicts only." },

    "onDark":         { "value": "#FFFFFF" }
  },

  "font": {
    "sans": { "value": "'IBM Plex Sans', system-ui, -apple-system, sans-serif" },
    "mono": { "value": "'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace" },
    "googleFontsHref": {
      "value": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    }
  },

  "type": {
    "displayXl": { "size": "clamp(38px, 7vw, 68px)",   "weight": 700, "lineHeight": 1.04, "tracking": "-0.038em" },
    "displayL":  { "size": "clamp(31px, 5.2vw, 52px)", "weight": 700, "lineHeight": 1.10, "tracking": "-0.034em" },
    "displayM":  { "size": "clamp(34px, 6vw, 42px)",   "weight": 700, "lineHeight": 1.10, "tracking": "-0.032em" },
    "verdict":   { "size": "clamp(48px, 9vw, 84px)",   "weight": 700, "lineHeight": 1.0,  "tracking": "-0.012em", "comment": "all-caps: tracking pulled back from display" },
    "verdictSm": { "size": "clamp(30px, 6vw, 44px)",   "weight": 700, "lineHeight": 1.0,  "tracking": "-0.012em" },
    "title":     { "size": "20px", "weight": 600, "lineHeight": 1.4,  "tracking": "-0.012em" },
    "subtitle":  { "size": "16px", "weight": 600, "lineHeight": 1.45 },
    "lede":      { "size": "clamp(16px, 2vw, 20px)", "weight": 400, "lineHeight": 1.75 },
    "body":      { "size": "15px", "weight": 400, "lineHeight": 1.75 },
    "bodySm":    { "size": "13px", "weight": 400, "lineHeight": 1.7 },
    "label":     { "size": "11px", "weight": 700, "tracking": "0.08em", "transform": "uppercase" },
    "mono":      { "size": "12px", "weight": 400, "tracking": "0.02em" }
  },

  "radius": {
    "control": { "value": "6px",   "comment": "buttons, inputs" },
    "card":    { "value": "8px" },
    "frame":   { "value": "20px",  "comment": "documentation device frames" },
    "pill":    { "value": "999px", "comment": "chips" }
  },

  "size": {
    "container":     { "value": "1180px" },
    "containerWide": { "value": "1320px", "comment": "registry console only" },
    "gutterMobile":  { "value": "20px" },
    "gutterDesktop": { "value": "32px" },
    "touchMin":      { "value": "44px" },
    "controlHeight": { "value": "52px" },
    "buttonHeight":  { "value": "56px" },
    "inputFontMin":  { "value": "16px", "comment": "smaller triggers zoom-on-focus in iOS Safari" }
  },

  "breakpoint": {
    "desktop": { "value": "900px" }
  },

  "motion": {
    "waterRise": { "transform": "translateY(46px) -> 0", "opacity": "0 -> 1", "duration": "1500ms", "easing": "cubic-bezier(.16,.84,.26,1)", "delay": "260ms" },
    "markFade":  { "opacity": "0 -> 1", "duration": "700ms", "easing": "ease-out", "delay": "1500ms" },
    "refuseShake": { "duration": "420ms", "easing": "ease-in-out" },
    "meter":     { "property": "width", "duration": "600ms", "easing": "ease" },
    "$note": "All of it sits behind @media (prefers-reduced-motion: reduce)."
  },

  "figure": {
    "viewBox": "0 0 240 372",
    "building": { "x": 48, "y": 28, "w": 144, "h": 308, "baseY": 336 },
    "floorLines": [79, 130, 181, 232, 283],
    "threshold": 0.70,
    "loadLineY": 120,
    "loadLineX": [22, 212],
    "plimsoll": { "cx": 48, "cy": 120, "r": 13 },
    "bracketPath": "M 30 28 L 22 28 L 22 336 L 30 336",
    "bandHeight": 36,
    "bands": {
      "safe":    { "bandTop": 173, "waterHeight": 162, "labelY": 111 },
      "caution": { "bandTop": 102, "waterHeight": 233, "labelY": 90 },
      "danger":  { "bandTop": 53,  "waterHeight": 282, "labelY": 141 }
    },
    "hatch":    { "size": 7, "rotate": 45, "strokeWidth": 2.4, "opacity": 0.45 },
    "gradient": { "stops": [[0, 0], [0.55, 0.26], [1, 0.22]] },
    "bandEdge": { "dasharray": "3 4", "opacity": 0.7 },
    "$rule": "NEVER render a solid surface line. The band with dashed edges IS the surface."
  },

  "behaviour": {
    "pipelineTimingMs": [[0, 1], [1100, 2], [4200, 3], [5200, 4], [6600, 5]],
    "proofBytes": { "callOnly": 5168, "withProof": 14432 },
    "constraints": 12904,
    "proverKeyBytes": 5100000,
    "verifierKeyBytes": 2100,
    "feeTDust": 0.0142,
    "attack": {
      "limitMillions": 199.5,
      "minMillions": 100,
      "maxMillions": 285,
      "stepMillions": 5,
      "defaultMillions": 165,
      "cautionFactor": 0.9,
      "provingMs": 2600
    }
  }
}
