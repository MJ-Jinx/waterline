{
  "name": "waterline",
  "version": "0.1.0",
  "description": "Prove a jeonse property isn't over-leveraged, without revealing anyone's deposit.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "compact compile +0.31.1 contracts/waterline.compact build/waterline",
    "test": "node --test test/contract.test.mjs test/site.test.mjs test/qr.test.mjs test/imports.test.mjs",
    "test:site": "node --test test/site.test.mjs test/qr.test.mjs test/imports.test.mjs",
    "test:contract": "node --test test/contract.test.mjs",
    "verify:refusal": "node --test --test-name-pattern=\"understates the total\" test/contract.test.mjs",
    "registry": "node src/registry.mjs",
    "certify": "node src/certify.mjs",
    "read": "node src/read.mjs",
    "snapshot": "node src/snapshot.mjs",
    "build:demo": "cd demo-src && vite build && cd .. && node src/stage-demo.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-abstractions": "^2.1.0",
    "@midnight-ntwrk/wallet-sdk-capabilities": "^3.3.1",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "^4.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^4.0.1",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "^3.0.1",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^3.1.0",
    "@polkadot/api": "^16.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^5.4.21",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
