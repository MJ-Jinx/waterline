node_modules/

# Compiled artifacts. 11 MB of ZK keys — regenerate with `npm run compile`.
# The tenant-facing page does NOT need these: issueCertificate publishes the
# band to the ledger, so /check is a plain GraphQL query. Only the side that
# proves (the registry console) needs keys, and it runs locally.
build/

# Registry secret key, contract address and commitment salts. NEVER commit:
# registryPk is sealed at construction, so this file is the only way to write
# to a deployed contract.
state.json

*.log
*.bin
*.hex
.DS_Store
